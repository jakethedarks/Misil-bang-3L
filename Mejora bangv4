-- 2. LÓGICA DE BANG OPTIMIZADA (Máxima velocidad, 0 congelamiento)
-- Usamos Heartbeat para que se ejecute en cada frame del servidor sin bloquear el hilo principal
local function iniciarBang(objetivo)
    if not objetivo or not objetivo.Character then return nil end

    local bangConnection
    bangConnection = RunService.Heartbeat:Connect(function()
        -- Verificación de seguridad rápida para no crashear tu propio ejecutor si el rival muere
        if not objetivo.Character or not objetivo.Character:FindFirstChild("HumanoidRootPart") or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            bangConnection:Disconnect()
            return
        end

        -- [AQUÍ INTEGRAS TU LÓGICA DE POSICIONAMIENTO/CFRAME]
        -- Al estar dentro de Heartbeat, se actualiza a la máxima velocidad posible del motor
        -- Ejemplo: LocalPlayer.Character.HumanoidRootPart.CFrame = objetivo.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 1)
    end)

    return bangConnection -- Retorna la conexión para poder apagar el Bang cuando quieras
end

