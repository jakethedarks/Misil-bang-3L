-- =========================================================
-- CONFIGURACIÓN
-- =========================================================
local URL_PASTEBIN = "https://pastebin.com/raw/7DtMZLxH"
local URL_MAIN_SCRIPT = "https://raw.githubusercontent.com/jakethedarks/Misil-bang-3L/refs/heads/main/Mejora%20bangv4"

-- =========================================================
-- SISTEMA DE PERSISTENCIA (QUEUE ON TELEPORT)
-- =========================================================
local queueteleport = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
if queueteleport then
    queueteleport([[
        task.spawn(function()
            loadstring(game:HttpGet("]] .. URL_MAIN_SCRIPT .. [["))()
        end)
    ]])
end

-- =========================================================
-- SERVICIOS Y RUTAS
-- =========================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Rutas de remotos (con manejo de errores por si el juego cambia la estructura)
local _pkg_original = ReplicatedStorage:WaitForChild("Packages", 5)
local _gR_original = _pkg_original and _pkg_original:FindFirstChild("Knit") and _pkg_original.Knit:FindFirstChild("Services") and _pkg_original.Knit.Services:FindFirstChild("CombatService") and _pkg_original.Knit.Services.CombatService:FindFirstChild("RF") and _pkg_original.Knit.Services.CombatService.RF:FindFirstChild("Grab")

local _pkg_nueva = ReplicatedStorage:WaitForChild("OldPackages", 5)
local _gR_nueva = _pkg_nueva and _pkg_nueva:FindFirstChild("Knit") and _pkg_nueva.Knit:FindFirstChild("Services") and _pkg_nueva.Knit.Services:FindFirstChild("CombatService") and _pkg_nueva.Knit.Services.CombatService:FindFirstChild("RF") and _pkg_nueva.Knit.Services.CombatService.RF:FindFirstChild("Grab")

-- =========================================================
-- CARGA ASÍNCRONA DE MÓDULOS (Sin congelar la pantalla)
-- =========================================================
task.spawn(function()
    pcall(function() loadstring(game:HttpGet("https://pastebin.com/raw/T5Q12QA3"))() end)
    pcall(function() loadstring(game:HttpGet("https://pastebin.com/raw/P9vnPEfs"))() end)
end)

-- =========================================================
-- BUCLE PRINCIPAL ULTRA RÁPIDO
-- =========================================================
task.spawn(function()
    task.wait(0.1) -- Breve margen para que los módulos externos compilen

    local exito, respuesta = pcall(function()
        return game:HttpGet(URL_PASTEBIN)
    end)

    if exito and respuesta then
        local names = string.split(respuesta, "\n")
        
        for _, nameLine in ipairs(names) do
            local cleanName = nameLine:match("^%s*(.-)%s*$")
            
            if cleanName and cleanName ~= "" then
                -- VERIFICACIÓN V1: Solo atacamos si el jugador realmente está en esta sala
                local targetPlayer = nil
                for _, p in pairs(Players:GetPlayers()) do
                    if string.lower(p.Name) == string.lower(cleanName) or string.lower(p.DisplayName) == string.lower(cleanName) then
                        targetPlayer = p
                        break
                    end
                end
                
                -- Si el jugador está presente y no eres tú, inicia el Bang y el seguimiento físico
                if targetPlayer and targetPlayer ~= LocalPlayer then
                    
                    -- Pasamos la info a tus módulos externos
                    getgenv().ObjetivoBang = cleanName
                    getgenv().DetenerBang = false

                    local startTime = tick()
                    
                    -- Bucle optimizado que fija la posición (CFrame) y spamea el grab simultáneamente
                    while tick() - startTime < 3 do
                        local myChar = LocalPlayer.Character
                        local targetChar = targetPlayer.Character
                        
                        -- Fuerza tu posición idéntica a la del objetivo para pegarte a él por completo
                        if myChar and myChar:FindFirstChild("HumanoidRootPart") and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                            myChar.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame
                        end

                        if _gR_original then 
                            task.defer(function() pcall(function() _gR_original:InvokeServer() end) end) 
                        end
                        if _gR_nueva then 
                            task.defer(function() pcall(function() _gR_nueva:InvokeServer() end) end) 
                        end
                        
                        RunService.Heartbeat:Wait()
                    end
                    
                    -- Frenamos el ataque para pasar al siguiente objetivo
                    getgenv().DetenerBang = true
                    task.wait(3.6) -- Pausa para limpiar animaciones antes del siguiente objetivo
                end
            end
        end
    end

    -- BUCLE TOXICO Al terminar de revisar a los que sí están, hace rejoin al mismo servidor
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end)
    
    task.wait(0)
end)
